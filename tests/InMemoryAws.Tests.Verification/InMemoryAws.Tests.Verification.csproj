<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <OutputType>Exe</OutputType>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <IsPackable>false</IsPackable>
      <NoWarn>$(NoWarn);CA1051;CA1707;CA2007</NoWarn>
      <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.DynamoDBv2" />
      <PackageReference Include="AWSSDK.EventBridge" />
      <PackageReference Include="AWSSDK.SQS" />
      <PackageReference Include="AWSSDK.SimpleNotificationService" />
      <PackageReference Include="Aspire.Hosting.Testing" />
      <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
      <PackageReference Include="OpenTelemetry" />
      <PackageReference Include="Shouldly" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\InMemoryAws\InMemoryAws.csproj" />
      <ProjectReference Include="..\InMemoryAws.Tests.Verification.AppHost\InMemoryAws.Tests.Verification.AppHost.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\InMemoryAws.Tests.Shared\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
