<Project Sdk="Microsoft.NET.Sdk">

    <!-- The InMemoryAws library against AWS SDK v4 on .NET Framework, where clients are wired through the SDK's request pipeline. -->
    <PropertyGroup>
      <TargetFramework>net48</TargetFramework>
      <OutputType>Exe</OutputType>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <IsPackable>false</IsPackable>
      <IsTestProject>true</IsTestProject>
      <NoWarn>$(NoWarn);CA1051;CA2007;CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.DynamoDBStreams" />
      <PackageReference Include="AWSSDK.DynamoDBv2" />
      <PackageReference Include="AWSSDK.EventBridge" />
      <PackageReference Include="AWSSDK.S3" />
      <PackageReference Include="AWSSDK.SQS" />
      <PackageReference Include="AWSSDK.SimpleNotificationService" />
      <PackageReference Include="Shouldly" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\InMemoryAws\InMemoryAws.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\InMemoryAws.Tests.AwsSdkV3\BringYourOwnSdkTests.cs" Link="BringYourOwnSdkTests.cs" />
    </ItemGroup>

    <!-- Adds the AWS SDK glue (CreateSqsClient() and the rest) as a package consumer gets it. -->
    <Import Project="..\..\src\InMemoryAws\build\InMemoryAws.targets" />

</Project>
