# Checks translated from the AWS emulator evaluation suite stay close to their Python source rather
# than meeting the library's analysis rules, so the code-quality (CA) analyzers that
# AnalysisMode=All enables are turned off for this folder. Compiler and TUnit diagnostics still apply.
[*.cs]
# ReceiveMessageRequest.AttributeNames is obsolete in the SDK, but the checks use it deliberately.
dotnet_diagnostic.CS0618.severity = none
