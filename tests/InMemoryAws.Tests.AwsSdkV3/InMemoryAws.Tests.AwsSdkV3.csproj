<Project Sdk="Microsoft.NET.Sdk">

    <!-- The InMemoryAws library against AWS SDK v3 (3.7.x), which consumers bring themselves, on .NET and .NET Framework. -->
    <PropertyGroup>
      <TargetFrameworks>net10.0;net48</TargetFrameworks>
      <DefineConstants>$(DefineConstants);AWS_SDK_V3</DefineConstants>
      <OutputType>Exe</OutputType>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <IsPackable>false</IsPackable>
      <IsTestProject>true</IsTestProject>
      <NoWarn>$(NoWarn);CA1051;CA2007;CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.DynamoDBv2" VersionOverride="3.7.513.4" />
      <PackageReference Include="AWSSDK.EventBridge" VersionOverride="3.7.502" />
      <PackageReference Include="AWSSDK.S3" VersionOverride="3.7.511.8" />
      <PackageReference Include="AWSSDK.SQS" VersionOverride="3.7.502" />
      <PackageReference Include="AWSSDK.SimpleNotificationService" VersionOverride="3.7.502" />
      <PackageReference Include="Shouldly" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\InMemoryAws\InMemoryAws.csproj" />
    </ItemGroup>

    <!-- Adds the AWS SDK glue (CreateSqsClient() and the rest) as a package consumer gets it. -->
    <Import Project="..\..\src\InMemoryAws\build\InMemoryAws.targets" />

</Project>
