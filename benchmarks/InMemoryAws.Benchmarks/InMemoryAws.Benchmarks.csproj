<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Request-path benchmarks: the same SDK calls through the library's in-memory handler and
      through the server's middleware (on an in-memory TestServer, so no sockets add noise).
      Built with the solution, never run by build.ps1 or CI; see Program.cs for how to run it.
    -->
    <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <OutputType>Exe</OutputType>
      <IsPackable>false</IsPackable>
      <!-- Benchmark classes are public, unsealed and own their clients for the whole run; BenchmarkDotNet needs that shape. -->
      <NoWarn>$(NoWarn);CA1001;CA1515;CA2000;CA1707;CA1822;CA2007;CA2234;CA5394;NU1901;NU1902</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.DynamoDBv2" />
      <PackageReference Include="AWSSDK.EventBridge" />
      <PackageReference Include="AWSSDK.SQS" />
      <PackageReference Include="AWSSDK.SimpleNotificationService" />
      <PackageReference Include="BenchmarkDotNet" />
      <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\InMemoryAws\InMemoryAws.csproj" />
      <!-- The server compiles the same shared source, so its public types clash with the library's: reach them through an alias. -->
      <ProjectReference Include="..\..\src\InMemoryAws.Server\InMemoryAws.Server.csproj" Aliases="server" />
    </ItemGroup>

</Project>
